# Copy to .env and fill in. Never commit .env.

PORT=3001
NODE_ENV=development

# --- SMTP (Gmail shown; any SMTP provider works) ---
# For Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=amulyakaushik7@gmail.com
SMTP_PASS=your-16-char-app-password

# --- OR Resend (HTTPS API; use on hosts that block SMTP, e.g. Render free tier) ---
# When set, SMTP settings are ignored. MAIL_FROM must use a domain verified in
# Resend (e.g. contact@amulyakaushik.co.in), or onboarding@resend.dev for testing.
# RESEND_API_KEY=re_xxxxxxxx

# Sender address (defaults to SMTP_USER) and where messages are delivered.
MAIL_FROM=amulyakaushik7@gmail.com
CONTACT_TO=amulyakaushik7@gmail.com
OWNER_NAME=Amulya Kaushik

# Send visitors a confirmation email (true/false).
AUTO_REPLY=true

# Comma-separated list of frontend origins allowed to call the API.
# Only needed when the frontend is hosted on a different domain from the API.
ALLOWED_ORIGINS=https://www.amulyakaushik.co.in,https://amulyakaushik.co.in,http://localhost:5173

# Set to true to also serve the built frontend (../dist) from this server.
SERVE_STATIC=false

# Max contact submissions per IP per window.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=15

# Number of reverse proxies in front of the server (1 on Render/Railway/Heroku).
TRUST_PROXY=1
